<script src="https://cdn.tailwindcss.com"></script>
<script>
  tailwind.config = {
    darkMode: 'class',
    theme: {
      extend: {
        colors: {
          ink:   '#0A0F14',
          ink2:  '#111820',
          ink3:  '#1B232D',
          line:  '#28323D',
          paper: '#F3F1EA',
          paper2:'#FFFFFF',
          sand:  '#E7E3D8',
          signal:'#3ED9A6',
          signal2:'#2BB98B',
          warn:  '#FF7A45',
        },
        fontFamily: {
          sans: ['Inter', 'sans-serif'],
          display: ['"Space Grotesk"', 'sans-serif'],
          mono: ['"JetBrains Mono"', 'monospace'],
        },
        boxShadow: {
          glow: '0 0 0 1px rgba(62,217,166,0.25), 0 8px 30px -8px rgba(62,217,166,0.35)',
